{
  "name": "resource-base",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "migrate": "tsx scripts/migrate/run.ts",
    "migrate:dry": "tsx scripts/migrate/run.ts --dry-run",
    "companies:build": "tsx scripts/companies/build.ts",
    "companies:import": "tsx scripts/companies/import.ts",
    "companies:import:dry": "tsx scripts/companies/import.ts --dry-run",
    "companies:sync": "tsx scripts/companies/sync.ts",
    "companies:sync:dry": "tsx scripts/companies/sync.ts --dry-run",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply resource-base --local",
    "db:migrate:remote": "wrangler d1 migrations apply resource-base --remote"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.7",
    "@opennextjs/cloudflare": "^1.19.11",
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.30.0",
    "better-auth": "^1.6.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.4.2",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-sanity": "^13.0.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.8",
    "sanity": "^5.30.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "mdast-util-to-string": "^4.0.0",
    "p-limit": "^7.3.0",
    "playwright": "^1.60.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "wrangler": "^4.100.0"
  }
}
