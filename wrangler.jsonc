{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resource-base",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Don't inject esbuild's `__name` helper: code that serializes a function
  // into an inline <script> (next-themes' theme script) would reference it in
  // the browser, where it doesn't exist, and fail on every worker-rendered page.
  "keep_names": false,
  // Keep variables set in the dashboard (ADMIN_EMAILS, the *_PAUSED switches,
  // DAILY_CAP_*) across deploys: without this every deploy deletes them.
  // Secrets are never deleted either way.
  "keep_vars": true,
  // Disabled so the site is reachable ONLY via the custom domains below, not the
  // auto-assigned *.workers.dev (+ preview) URLs. Those served a full duplicate
  // of the site (200 OK), which Google could index as duplicate content and
  // split ranking away from resource-base.com.
  "workers_dev": false,
  // Logs are sampled: every request was logged before, and log events past the
  // plan's monthly allowance are billed. 10% is plenty to spot errors/trends.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // Hard ceiling per request so a pathological render can't burn CPU time
  // (billed past the plan's allowance). Real pages use a small fraction.
  "limits": { "cpu_ms": 5000 },
  // Custom domains — Cloudflare auto-creates the DNS records + SSL.
  "routes": [
    { "pattern": "resource-base.com", "custom_domain": true },
    { "pattern": "www.resource-base.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // Application database (Better Auth + app tables).
      "binding": "DB",
      "database_name": "resource-base",
      "database_id": "30e17abb-8039-46ae-b507-cba92062f4b8",
      "migrations_dir": "drizzle"
    },
    {
      // OpenNext tag cache — powers revalidateTag (Sanity webhook). Reserved binding name.
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "resource-base-tag-cache",
      "database_id": "58c4eb39-cb97-4721-876e-cf857ca15033"
    }
  ],
  "kv_namespaces": [
    {
      // OpenNext incremental (page) cache. Reserved binding name.
      "binding": "NEXT_INC_CACHE_KV",
      "id": "7972c906f2c84a05adf9975ba9a95643"
    }
  ],
  // Uploaded CVs (PDF). R2's free tier covers 10 GB and egress is free; with
  // one CV per user capped at 2 MB that is ~5,000+ CVs before any charge.
  "r2_buckets": [{ "binding": "CV_BUCKET", "bucket_name": "resource-base-cvs" }],
  // Workers Rate Limiting — per-location counters kept in memory by Cloudflare,
  // free and with no KV/D1 writes. Used for every short-window abuse limit
  // (lib/rate-limit.ts `overLimit`); KV is kept only for hourly/daily caps.
  "ratelimits": [
    // Anonymous endpoints, keyed by IP (click counting).
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Signed-in writes, keyed by user (favorites, tracker, notifications, profile).
    { "name": "RL_USER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Expensive writes that create Sanity documents (submissions), keyed by user.
    { "name": "RL_SUBMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    // Every dynamic request, keyed by IP (middleware): the outer shield that
    // stops one client from turning traffic into renders and cost.
    { "name": "RL_GLOBAL", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
    // The auth API (sign-in, sign-up, emails…), keyed by IP (middleware).
    { "name": "RL_AUTH", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],
  // Cloudflare Email Sending — used only by Better Auth password reset.
  "send_email": [{ "name": "EMAIL" }],
  // Self-reference service binding. OpenNext's ISR revalidation calls back into
  // this worker to regenerate stale pages; without it any stale ISR page throws
  // "No service binding for cache revalidation worker" (500). Must match `name`.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "resource-base" }
  ],
  // Durable Object queue for OpenNext ISR revalidation (NEXT_CACHE_DO_QUEUE).
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
  // The daily link-check cron runs in a separate Worker (workers/link-check-cron),
  // so this app stays a clean OpenNext worker. See that dir's wrangler.jsonc.
}
