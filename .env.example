# ── Sanity (content) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only read token (Viewer role) — public site read client. Never client-side.
SANITY_API_READ_TOKEN=
# Server-only write token (Editor role) — submissions, moderation, migration.
# Runtime secret only: never a build variable. Never client-side.
SANITY_API_WRITE_TOKEN=
# Secret shared with the Sanity webhook that triggers on-demand revalidation
SANITY_REVALIDATE_SECRET=
# Secret shared with the Sanity webhook that fires submission-approval notifications
SANITY_NOTIFY_SECRET=

# ── Public site ────────────────────────────────────────────────────────────
# Public site URL (sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile site key (public) — bot protection on the auth forms.
# Create a widget at dash.cloudflare.com → Turnstile. Leave blank to disable
# (local dev only: in production a missing key turns email sign-up/sign-in off).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# The values below run on Cloudflare (Better Auth + D1 + Email). For LOCAL dev
# they live in `.dev.vars` (gitignored); for production set them with
# `wrangler secret put <NAME>` or the Cloudflare dashboard. Listed for reference
# — do NOT put real secrets in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Better Auth ────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app (http://localhost:3000 in dev, https://resource-base.com
# in production — it must not contain "localhost" there)
BETTER_AUTH_URL=

# ── OAuth (reused from the prior setup) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ── Email (Cloudflare Email Sending — requires Workers Paid) ────────────────
# From address; must be on a domain enabled via `wrangler email sending enable`
EMAIL_FROM=

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────
# Secret key paired with NEXT_PUBLIC_TURNSTILE_SITE_KEY above. Server-only —
# Better Auth verifies the challenge token against Cloudflare with this.
# Required in production: without it, email sign-up/sign-in/reset are refused
# (OAuth still works). Locally Cloudflare's test key is used.
TURNSTILE_SECRET_KEY=

# ── Emergency switches (optional, set "1" in the dashboard to pause) ───────
# SIGNUPS_PAUSED=1      no new accounts
# SUBMISSIONS_PAUSED=1  no new resource/company suggestions or edits
# UPLOADS_PAUSED=1      no CV or profile photo uploads
